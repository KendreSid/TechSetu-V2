---
/**
 * Round-cornered social icons. An icon is shown only when its address
 * is filled in src/config.ts, so a visitor never taps an icon that goes nowhere.
 */
import { config } from '../config';

const { social } = config;
---
<div class="fol">
  {social.yt && (
    <a href={social.yt} target="_blank" rel="noopener" aria-label="TechSetu YouTube">
      <svg viewBox="0 0 40 40"><rect width="40" height="40" rx="10" fill="#FF0000" /><path d="M16 13l11 7-11 7z" fill="#fff" /></svg>
    </a>
  )}
  {social.fb && (
    <a href={social.fb} target="_blank" rel="noopener" aria-label="TechSetu Facebook">
      <svg viewBox="0 0 40 40"><rect width="40" height="40" rx="10" fill="#1877F2" /><path d="M22 33V21h4l.7-4.6H22v-3c0-1.3.6-2.4 2.5-2.4h2.3V7.1c-.4-.1-1.8-.2-3.3-.2-3.5 0-5.8 2.1-5.8 6v3.5h-3.9V21h3.9v12z" fill="#fff" /></svg>
    </a>
  )}
  {social.ig && (
    <a href={social.ig} target="_blank" rel="noopener" aria-label="TechSetu Instagram">
      <svg viewBox="0 0 40 40">
        <defs><linearGradient id="igGrad" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#FEDA75" /><stop offset=".45" stop-color="#EE2A7B" /><stop offset="1" stop-color="#5B3BD6" /></linearGradient></defs>
        <rect width="40" height="40" rx="10" fill="url(#igGrad)" /><rect x="10" y="10" width="20" height="20" rx="6" fill="none" stroke="#fff" stroke-width="2.5" /><circle cx="20" cy="20" r="5" fill="none" stroke="#fff" stroke-width="2.5" /><circle cx="26" cy="14" r="1.6" fill="#fff" />
      </svg>
    </a>
  )}
  {social.tg && (
    <a href={social.tg} target="_blank" rel="noopener" aria-label="TechSetu Telegram">
      <svg viewBox="0 0 40 40"><rect width="40" height="40" rx="10" fill="#27A7E7" /><path d="M31 11 9 19.6l5.8 2.3 2.2 6.9 3.6-3.7 6.2 4.5z" fill="#fff" /><path d="M14.8 21.9 28 13.6 17.8 25.2z" fill="#BFE3F7" /></svg>
    </a>
  )}
</div>
