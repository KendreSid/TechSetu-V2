---
/**
 * The frame every page shares: <head> (title, SEO, language links), header, footer.
 * Pages only provide the middle part through <slot />.
 */
import '../styles/global.css';
import { languages, type Lang } from '../i18n/ui';
import { getLangFromUrl, useTranslations, localizedPath, stripLang } from '../i18n/utils';
import { config } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = `TechSetu - ${t('site.tagline')}`, description = t('meta.description') } = Astro.props;
const home = localizedPath('/', lang);

// The same page in every language. Search engines use these to show the right
// language to the right visitor (hreflang).
const basePath = stripLang(Astro.url.pathname);
const site = Astro.site ?? Astro.url;
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: new URL(localizedPath(basePath, code), site).href,
}));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06122E" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Hind:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <div class="wrap bar">
        <a class="brand" href={home} aria-label="TechSetu">
          <img src="/images/logo-256.png" alt="" width="46" height="46" />
          <span><b>TechSetu</b><small>{t('site.tagline')}</small></span>
        </a>
        <nav aria-label="Main">
          <a href={home}>{t('nav.home')}</a>
          <a href={`${home}#videos`}>{t('nav.videos')}</a>
          <a href={`${home}#articles`}>{t('nav.articles')}</a>
          <a href={`${home}#topics`}>{t('nav.topics')}</a>
          <a href={`${home}#about`}>{t('nav.about')}</a>
        </nav>
        <div class="rt">
          <div class="lang" translate="no" role="group" aria-label="Language">
            {alternates.map((alt) => (
              <a href={localizedPath(basePath, alt.code)} hreflang={alt.code} aria-current={alt.code === lang ? 'page' : undefined}>
                {languages[alt.code]}
              </a>
            ))}
          </div>
          <a class="btn dark" href={config.channelUrl} target="_blank" rel="noopener" aria-label={t('cta.subscribe')}>
            <span class="play"></span><span class="bt">{t('cta.subscribe')}</span>
          </a>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <a class="brand" href={home}>
          <img src="/images/logo-256.png" alt="" width="46" height="46" />
          <span><b>TechSetu</b><small>{t('site.tagline')}</small></span>
        </a>
        <nav>
          <a href={home}>{t('nav.home')}</a>
          <a href={`${home}#videos`}>{t('nav.videos')}</a>
          <a href={`${home}#articles`}>{t('nav.articles')}</a>
          <a href={`${home}#about`}>{t('nav.about')}</a>
        </nav>
        <span>&copy; {new Date().getFullYear()} {t('footer.rights')}</span>
      </div>
    </footer>
  </body>
</html>
